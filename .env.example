# Service-Account-Zugangsdaten für den read-only Zugriff auf die Google Sheets.
# Siehe README.md ("Google Sheets Zugriff einrichten") für die Schritt-für-Schritt-Anleitung.

GOOGLE_SERVICE_ACCOUNT_EMAIL=my-dashboard@my-project.iam.gserviceaccount.com
# Den kompletten private_key aus dem JSON-Key in Anführungszeichen einfügen,
# Zeilenumbrüche als \n belassen (nicht durch echte Newlines ersetzen).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: nur setzen, falls andere Spreadsheet-IDs verwendet werden sollen.
# INTERIM_SPREADSHEET_ID=1RJNkH_WOMxDJwbWj5LP_nxCutUfpkXkI_nryglzrpT0
# OPEN_MARKET_SPREADSHEET_ID=10n-vWPuJMUv-TkmjjxupiBKoIgrobfDED1xKWQC0DsA
